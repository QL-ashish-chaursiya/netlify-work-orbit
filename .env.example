# Frontend (Vite) — safe to expose in the browser bundle
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions only (set via `supabase secrets set`, never in frontend .env)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER ship this to the client
